    "rules": [
      {
        "when": {
          "q": "q1_pushups",
          "op": "eq",
          "value": 0
        },
        "set": {
          "push_up": "push_up.wall"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "between",
          "value": [
            1,
            4
          ]
        },
        "set": {
          "push_up": "push_up.knee"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "between",
          "value": [
            5,
            9
          ]
        },
        "set": {
          "push_up": "push_up.full"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "between",
          "value": [
            10,
            14
          ]
        },
        "set": {
          "push_up": "push_up.full"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "gte",
          "value": 15
        },
        "set": {
          "push_up": "push_up.full_high"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "lte",
          "value": 4
        },
        "set": {
          "diamond_push_up": "diamond_push_up.wall"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "between",
          "value": [
            5,
            14
          ]
        },
        "set": {
          "diamond_push_up": "diamond_push_up.incline"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "gte",
          "value": 15
        },
        "set": {
          "diamond_push_up": "diamond_push_up.knee"
        }
      },
      {
        "when": {
          "q": "q1_pushups",
          "op": "gte",
          "value": 5
        },
        "set": {
          "pike_push_up": "pike_push_up.floor"
        }
      },
      {
        "when": {
          "q": "q2_squat",
          "op": "eq",
          "value": "none"
        },
        "set": {
          "goblet_squat": "goblet_squat.chair"
        }
      },
      {
        "when": {
          "q": "q2_squat",
          "op": "eq",
          "value": "sit_to_stand_10"
        },
        "set": {
          "goblet_squat": "goblet_squat.bw_squat"
        }
      },
      {
        "when": {
          "q": "q2_squat",
          "op": "eq",
          "value": "bw_squat_15"
        },
        "set": {
          "goblet_squat": "goblet_squat.db12",
          "step_up": "step_up.chair"
        }
      },
      {
        "when": {
          "q": "q3_plank",
          "op": "eq",
          "value": "lt20"
        },
        "set": {
          "plank_side_plank": "plank_side_plank.knee",
          "hollow_hold": "hollow_hold.dead_bug"
        }
      },
      {
        "when": {
          "q": "q3_plank",
          "op": "eq",
          "value": "20_45"
        },
        "set": {
          "plank_side_plank": "plank_side_plank.short",
          "hollow_hold": "hollow_hold.tuck_hold"
        }
      },
      {
        "when": {
          "q": "q3_plank",
          "op": "eq",
          "value": "gt45"
        },
        "set": {
          "plank_side_plank": "plank_side_plank.medium",
          "hollow_hold": "hollow_hold.tuck_extend",
          "hip_thrust": "hip_thrust.db20"
        }
      },
      {
        "when": {
          "q": "q4_hinge",
          "op": "eq",
          "value": true
        },
        "set": {
          "hinge_deadlift": "hinge_deadlift.rdl_12"
        }
      },
      {
        "when": {
          "q": "q5_overhead",
          "op": "eq",
          "value": "easy"
        },
        "set": {
          "db_overhead_press": "db_overhead_press.half_kneel_10",
          "db_lateral_raise": "db_lateral_raise.db10",
          "db_rear_delt_fly": "db_rear_delt_fly.db8",
          "db_curl": "db_curl.db10",
          "db_hammer_curl": "db_hammer_curl.db10",
          "db_triceps_extension": "db_triceps_extension.db10",
          "db_floor_press": "db_floor_press.db10"
        }
      },
      {
        "when": {
          "q": "q6_carry",
          "op": "eq",
          "value": true
        },
        "set": {
          "db_row": "db_row.db20",
          "suitcase_carry": "suitcase_carry.db20",
          "farmer_carry": "farmer_carry.db20",
          "db_shrug": "db_shrug.db20"
        }
      },
      {
        "when": {
          "q": "q7_cardio",
          "op": "eq",
          "value": "cannot_20"
        },
        "set": {
          "treadmill_zone2": "treadmill_zone2.flat_20"
        }
      },
      {
        "when": {
          "q": "q7_cardio",
          "op": "eq",
          "value": "comfortable"
        },
        "set": {
          "treadmill_zone2": "treadmill_zone2.w30_2"
        }
      },
      {
        "when": {
          "q": "q7_cardio",
          "op": "eq",
          "value": "can_jog_5"
        },
        "set": {
          "treadmill_zone2": "treadmill_zone2.w30_4"
        }
      }
    ],
    "default_step": "first",
    "locked": [
      {
        "id": "parq_hold",
        "when": {
          "q": "q_parq",
          "op": "eq",
          "value": true
        },
        "lock": [
          "treadmill_intervals"
        ],
        "lock_benchmarks": [
          "bb_mile_time",
          "bb_swings_5min"
        ],
        "note": "Health screen flagged. Zone-2 walking and all strength work continue as written; intervals, the mile time trial and the five-minute swing test stay locked until a doctor clears you. Tell the app once you are cleared."
      },
      {
        "id": "vest_walk_hold",
        "when": {
          "q": "q7_cardio",
          "op": "in",
          "value": [
            "cannot_20",
            "comfortable",
            "can_jog_5"
          ]
        },
        "lock": [
          "vest_walk"
        ],
        "note": "Vest walks always start locked, whatever your cardio answer. They open when the Zone-2 ladder reaches treadmill_zone2.w33_8."
      },
      {
        "id": "shoulder_screen_fail",
        "when": {
          "q": "q_shoulder_slides",
          "op": "eq",
          "value": false
        },
        "cap": {
          "db_overhead_press": "db_overhead_press.half_kneel_8",
          "pike_push_up": "pike_push_up.incline"
        },
        "note": "Wall slides were painful or blocked. Overhead pressing stays at the first rung until the slides are clean. See a clinician before loading overhead."
      },
      {
        "id": "hip_knee_screen_fail",
        "when": {
          "q": "q_hip_sit_stand",
          "op": "eq",
          "value": false
        },
        "cap": {
          "goblet_squat": "goblet_squat.chair",
          "split_squat": "split_squat.wall_assist",
          "step_up": "step_up.low"
        },
        "note": "Sit-to-stands hurt. Squat, lunge and step-up patterns stay at the first rung until 10 sit-to-stands are pain-free. See a clinician if it persists a week."
      },
      {
        "id": "injury_low_back",
        "when": {
          "q": "q_injuries",
          "op": "contains",
          "value": "low_back"
        },
        "cap": {
          "hinge_deadlift": "hinge_deadlift.wall_drill",
          "swing": "swing.hike_park_20",
          "hip_thrust": "hip_thrust.bw"
        },
        "note": "Low-back flag: start every hinge at the wall drill and earn the pattern with the checklist before load."
      },
      {
        "id": "injury_shoulder",
        "when": {
          "q": "q_injuries",
          "op": "contains",
          "value": "shoulder"
        },
        "cap": {
          "db_overhead_press": "db_overhead_press.half_kneel_8",
          "pike_push_up": "pike_push_up.incline",
          "db_lateral_raise": "db_lateral_raise.db8"
        },
        "note": "Shoulder flag: overhead work starts at the lightest rung regardless of the 8 lb test."
      },
      {
        "id": "injury_knee",
        "when": {
          "q": "q_injuries",
          "op": "contains",
          "value": "knee"
        },
        "cap": {
          "goblet_squat": "goblet_squat.chair",
          "split_squat": "split_squat.wall_assist",
          "step_up": "step_up.low"
        },
        "note": "Knee flag: start at the shallowest rung, add depth before load."
      },
      {
        "id": "injury_wrist",
        "when": {
          "q": "q_injuries",
          "op": "contains",
          "value": "wrist"
        },
        "cap": {
          "push_up": "push_up.incline",
          "diamond_push_up": "diamond_push_up.wall"
        },
        "note": "Wrist flag: press on an incline (less wrist extension) and use a fist or handles if the floor still hurts."
      },
      {
        "id": "injury_neck",
        "when": {
          "q": "q_injuries",
          "op": "contains",
          "value": "neck"
        },
        "cap": {
          "neck_isometrics": "neck_isometrics.iso10",
          "db_shrug": "db_shrug.db12",
          "farmer_carry": "farmer_carry.db12"
        },
        "note": "Neck flag: isometrics only at the shortest hold, light carries, no shrug load until pain-free for 7 days."
      }
    ]
  }
}
