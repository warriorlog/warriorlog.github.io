{
  "benchmarks": [
    {
      "id": "bb_mile_time",
      "name": "Boss Battle 1: One-mile time trial",
      "unit": "sec",
      "higher_is_better": false,
      "order": 1,
      "region": "heart",
      "parent_exercise": "treadmill_intervals",
      "every_weeks": 4,
      "health_screen_required": true,
      "locked_note": "Locked until the PAR-Q health screen is answered and any 'yes' is cleared by a doctor. Same lock as the interval ladder.",
      "protocol": "First test of the boss script. 3 min easy walk warm-up at 2.8 mph, 1% incline, then 1.00 mile on the treadmill, hands off the rails, stop the clock at 1.00 mile. Log the time as minutes:seconds; the app stores seconds. One treadmill, two people: the second user runs the mile on Sunday in place of the recovery walk, then rejoins the Saturday script for the other five tests. 8 min easy walk before the next test.",
      "variants": [
        {
          "id": "run",
          "when": [
            {
              "rule": "ladder_at_or_past",
              "exercise": "treadmill_intervals",
              "step_id": "treadmill_intervals.jog_8"
            }
          ],
          "how": "Run/walk the mile as fast as you can hold form. Never set the belt above the work speed of your current interval step (jog_8 = 5.0 mph, run_9 = 5.5, run_10 and above = 6.0); the RUN GATE speed cap applies to the test exactly as it does to a training interval.",
          "multiplier": 1,
          "tiers": [
            3600,
            720,
            569,
            479
          ],
          "tier_cap": 3
        },
        {
          "id": "walk",
          "when": [],
          "how": "Fastest one-mile WALK. Belt capped at 4.5 mph, no jogging, no rails, 1% incline. This is the test until the interval ladder reaches treadmill_intervals.jog_8; it is a real test with its own tier table, not a consolation prize.",
          "multiplier": 1,
          "tiers": [
            3600,
            1080,
            900,
            779
          ],
          "tier_cap": 3
        }
      ]
    },
    {
      "id": "bb_pushups_2min",
      "name": "Boss Battle 2: Two-minute push-ups",
      "unit": "reps",
      "higher_is_better": true,
      "order": 2,
      "region": "chest",
      "parent_exercise": "push_up",
      "every_weeks": 4,
      "protocol": "Second test, 8 min after the mile. Max clean reps in 2 minutes, rest only in the top plank (never on the floor), chest to fist height and full lockout on every rep. A rep with sagging hips does not count. 3 min rest before the next test.",
      "variants": [
        {
          "id": "full",
          "when": [
            {
              "rule": "ladder_at_or_past",
              "exercise": "push_up",
              "step_id": "push_up.full"
            }
          ],
          "how": "Full push-ups on the toes, 1 point each.",
          "multiplier": 1,
          "tiers": [
            0,
            15,
            30,
            45
          ],
          "tier_cap": 3
        },
        {
          "id": "knee",
          "when": [],
          "how": "Knee push-ups, scored 0.5 each. Same 2-minute clock, same lockout standard.",
          "multiplier": 0.5,
          "tiers": [
            0,
            15,
            30,
            45
          ],
          "tier_cap": 1
        }
      ]
    },
    {
      "id": "bb_hollow_hold",
      "name": "Boss Battle 3: Max hollow hold",
      "unit": "sec",
      "higher_is_better": true,
      "order": 3,
      "region": "core",
      "parent_exercise": "hollow_hold",
      "every_weeks": 4,
      "protocol": "Third test, 3 min rest after the push-ups. One attempt. The clock stops the moment the low back lifts off the floor, the legs drop below 6 in, or the arms come down. 3 min rest before the next test.",
      "variants": [
        {
          "id": "full",
          "when": [
            {
              "rule": "ladder_at_or_past",
              "exercise": "hollow_hold",
              "step_id": "hollow_hold.full_hollow"
            }
          ],
          "how": "Full hollow: legs straight, arms overhead, low back pressed flat. 1 point per second.",
          "multiplier": 1,
          "tiers": [
            0,
            30,
            60,
            90
          ],
          "tier_cap": 3
        },
        {
          "id": "tuck",
          "when": [],
          "how": "Tuck hollow: knees over hips, shins parallel to the floor, arms at the shins, low back flat. Scored 0.5 s per second held.",
          "multiplier": 0.5,
          "tiers": [
            0,
            30,
            60,
            90
          ],
          "tier_cap": 1
        }
      ]
    },
    {
      "id": "bb_swings_5min",
      "name": "Boss Battle 4: Five-minute swings",
      "unit": "reps",
      "higher_is_better": true,
      "order": 4,
      "region": "glutes",
      "parent_exercise": "swing",
      "every_weeks": 4,
      "health_screen_required": true,
      "locked_note": "Locked until the PAR-Q health screen is answered and any 'yes' is cleared by a doctor.",
      "protocol": "Fourth test, 3 min rest after the hollow hold. Two-hand swings to chest height, any rest scheme you like inside a 5-minute cap. The swing checklist is enforced: three broken reps (rounded back, squatting, arms lifting the bell) end the test and the score stands at the last clean rep. The test NEVER falls back to a deadlift; if the swing ladder has not earned a continuous swing yet, the test is locked and scores zero. 3 min rest before the next test.",
      "variants": [
        {
          "id": "kb53",
          "when": [
            {
              "rule": "ladder_at_or_past",
              "exercise": "swing",
              "step_id": "swing.cont_53"
            }
          ],
          "how": "Continuous two-hand swings with the 53 lb kettlebell.",
          "implement_id": "kb53",
          "multiplier": 1,
          "tiers": [
            0,
            50,
            80,
            110
          ],
          "tier_cap": 3
        },
        {
          "id": "db",
          "when": [
            {
              "rule": "ladder_at_or_past",
              "exercise": "swing",
              "step_id": "swing.cont_20"
            }
          ],
          "how": "Continuous two-hand swings with the dumbbell your swing ladder is currently on (20 lb or 35 lb). Tier caps at soldier until the 53 lb bell is earned.",
          "implement_rule": {
            "kind": "current_ladder_implement",
            "exercise": "swing"
          },
          "multiplier": 1,
          "tiers": [
            0,
            50,
            80,
            110
          ],
          "tier_cap": 1
        },
        {
          "id": "locked",
          "when": [],
          "how": "Locked. You are still on hike-and-park or dead-stop swings, which are not continuous swings; a max continuous-swing test is not safe yet and there is no deadlift substitute.",
          "locked": true,
          "lock_note": "Earn swing.cont_20 (continuous swings, 20 lb dumbbell) to unlock this boss.",
          "multiplier": 0,
          "tier_points": 0,
          "tiers": [
            0,
            50,
            80,
            110
          ],
          "tier_cap": 0
        }
      ]
    },
    {
      "id": "bb_goblet_bw",
      "name": "Boss Battle 5: Max goblet squats at your bodyweight load",
      "unit": "reps",
      "higher_is_better": true,
      "order": 5,
      "region": "thighs",
      "parent_exercise": "goblet_squat",
      "every_weeks": 4,
      "protocol": "Fifth test, 3 min rest after the swings. Max unbroken goblet squats, thighs below parallel, elbows inside the knees, no rest longer than 3 s standing at the top. The set ends at the first rest over 3 s or the first rep above parallel. The load is chosen by the app from your local profile (see load_rule) and is never picked by hand. 3 min rest before the last test.",
      "load_rule": {
        "kind": "heaviest_allowed",
        "bodyweight_source": "local_profile",
        "note": "Bodyweight never leaves the phone; the owner's device resolves this rule and stores only the resulting implement id with the score.",
        "max_pct_bodyweight": 35,
        "requires_ladder_reached": true,
        "candidates": [
          {
            "lb": 12,
            "implement_id": "db12",
            "step_id": "goblet_squat.db12"
          },
          {
            "lb": 20,
            "implement_id": "db20",
            "step_id": "goblet_squat.db20"
          },
          {
            "lb": 35,
            "implement_id": "db35",
            "step_id": "goblet_squat.db35"
          },
          {
            "lb": 53,
            "implement_id": "kb53",
            "step_id": "goblet_squat.kb53"
          }
        ],
        "select": "heaviest candidate whose lb <= 0.35 * bodyweight_lb AND whose step_id the goblet_squat ladder has reached",
        "below_target_tier_cap": 1,
        "below_target_note": "If the heaviest ladder-reached implement is lighter than the heaviest implement allowed by 35% of bodyweight, test the lighter one and cap the tier at soldier."
      },
      "variants": [
        {
          "id": "loaded",
          "when": [
            {
              "rule": "ladder_at_or_past",
              "exercise": "goblet_squat",
              "step_id": "goblet_squat.db12"
            }
          ],
          "how": "Goblet squats holding the implement resolved by load_rule. The 53 lb bell is deadlifted to the knees and curled to the chest with two hands, never swung up.",
          "uses_load_rule": true,
          "multiplier": 1,
          "tiers": [
            0,
            10,
            20,
            30
          ],
          "tier_cap": 3,
          "tier_cap_below_target": 1
        },
        {
          "id": "bodyweight",
          "when": [],
          "how": "No loaded goblet step reached yet: max unbroken bodyweight squats to the same depth standard, arms forward as a counterweight, chair behind you as a depth target.",
          "multiplier": 1,
          "tiers": [
            0,
            10,
            20,
            30
          ],
          "tier_cap": 1
        }
      ]
    },
    {
      "id": "bb_vest_stepups_3min",
      "name": "Boss Battle 6: Three-minute step-ups",
      "unit": "reps",
      "higher_is_better": true,
      "order": 6,
      "region": "glutes",
      "parent_exercise": "step_up",
      "every_weeks": 4,
      "protocol": "Sixth and last test, 3 min rest after the goblet squats, then the cooldown flow. Alternating step-ups on the braced chair or the couch cushion at the height stored at setup (if the seat is higher than 0.28 x your height, use the 8-12 in cushion), full hip and knee extension at the top, count one rep per foot up. Hands off the wall except for balance.",
      "variants": [
        {
          "id": "vest10",
          "when": [
            {
              "rule": "ladder_at_or_past",
              "exercise": "step_up",
              "step_id": "step_up.vest10"
            }
          ],
          "how": "Wearing the vest at 10% bodyweight, rounded down to the vest increment.",
          "load": {
            "kind": "bw_vest",
            "lb": 0,
            "n": 1,
            "vest_pct": 10,
            "cap_lb": 30
          },
          "implement_id": "vest",
          "multiplier": 1,
          "tiers": [
            0,
            40,
            60,
            80
          ],
          "tier_cap": 3
        },
        {
          "id": "unweighted",
          "when": [],
          "how": "Bodyweight step-ups, no vest. The vest is not worn until the step_up ladder reaches step_up.vest10.",
          "load": {
            "kind": "bw",
            "lb": 0,
            "n": 1,
            "vest_pct": null,
            "cap_lb": null
          },
          "implement_id": "bw",
          "multiplier": 1,
          "tiers": [
            0,
            40,
            60,
            80
          ],
          "tier_cap": 1
        }
      ]
    }
  ],
  "placement": {
    "notes": [
      "Target time: about 60 seconds per user. Screens first, then Q1-Q8, then the shared equipment card (asked once for the household, editable by either user).",
      "swing ALWAYS starts at swing.hike_park_20 and whatever the answer to q8_kb. Both are ord 1, so default_step 'first' already produces this and no rule may override it.",
      "treadmill_intervals always starts at ord 1 (treadmill_intervals.walk_6); the RUN GATE, not the quiz, opens jogging.",
      "Bodyweight, height, age and sex live only on the owner's phone. No placement rule reads them, which is why the original 'goblet 20 lb if bodyweight >= 160 lb' and 'press 12 lb if male >= 160 lb' bumps were dropped: a beginner starting one rung lower costs two weeks, starting one rung too high costs a back."
    ],
    "questions": [
      {
        "id": "q_parq",
        "group": "screen",
        "type": "bool",
        "prompt": "In the last 12 months, any of these: chest pain or pressure with exertion, dizziness or fainting, a diagnosed heart condition, high blood pressure that is not controlled, or a doctor telling you to limit exercise?",
        "help": "Answer yes if ANY one applies. Yes does not stop you training; it locks the running and max-swing tests until a doctor clears you.",
        "sets_setting": "health.parq_flag"
      },
      {
        "id": "q_injuries",
        "group": "screen",
        "type": "choice",
        "multi": true,
        "prompt": "Any joint or area that currently hurts, or that you have injured before?",
        "choices": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "low_back",
            "label": "Low back"
          },
          {
            "value": "shoulder",
            "label": "Shoulder"
          },
          {
            "value": "knee",
            "label": "Knee"
          },
          {
            "value": "wrist",
            "label": "Wrist"
          },
          {
            "value": "neck",
            "label": "Neck"
          }
        ],
        "sets_setting": "health.injury_flags"
      },
      {
        "id": "q_shoulder_slides",
        "group": "screen",
        "type": "bool",
        "prompt": "Standing with your back to a wall, can you do 10 slow wall slides (arms overhead and back down, wrists staying on the wall) with no pain and no shrugging?",
        "sets_setting": "health.shoulder_screen_pass"
      },
      {
        "id": "q_hip_sit_stand",
        "group": "screen",
        "type": "bool",
        "prompt": "Can you stand up from a dining chair and sit back down 10 times, hands off your thighs, with no hip or knee pain?",
        "sets_setting": "health.hip_knee_screen_pass"
      },
      {
        "id": "q1_pushups",
        "group": "placement",
        "type": "int",
        "prompt": "Max clean full push-ups in one set right now (chest to fist height, straight line, no sagging)? Enter 0 if you cannot do one.",
        "min": 0,
        "max": 100
      },
      {
        "id": "q2_squat",
        "group": "placement",
        "type": "choice",
        "prompt": "Squat test - pick the hardest one that is true:",
        "choices": [
          {
            "value": "none",
            "label": "I cannot do 10 pain-free sit-to-stands from a chair"
          },
          {
            "value": "sit_to_stand_10",
            "label": "10 pain-free chair sit-to-stands, yes"
          },
          {
            "value": "bw_squat_15",
            "label": "That, plus 15 full-depth bodyweight squats"
          }
        ]
      },
      {
        "id": "q3_plank",
        "group": "placement",
        "type": "choice",
        "prompt": "How long can you hold a front plank with a flat back?",
        "choices": [
          {
            "value": "lt20",
            "label": "Under 20 seconds"
          },
          {
            "value": "20_45",
            "label": "20 to 45 seconds"
          },
          {
            "value": "gt45",
            "label": "Over 45 seconds"
          }
        ]
      },
      {
        "id": "q4_hinge",
        "group": "placement",
        "type": "bool",
        "prompt": "Hinge test: 10 wall hinges (butt taps the wall, shins vertical, back flat) hitting all 5 checklist points?",
        "help": "Flat back, weight in the mid-foot, shins vertical, chest proud, hips travel back not down."
      },
      {
        "id": "q5_overhead",
        "group": "placement",
        "type": "choice",
        "prompt": "Overhead test: 10 presses with an 8 lb dumbbell, half-kneeling, one arm.",
        "choices": [
          {
            "value": "cannot",
            "label": "I cannot do 10, or it hurts"
          },
          {
            "value": "with_effort",
            "label": "10 reps, but they were work"
          },
          {
            "value": "easy",
            "label": "10 reps, easy"
          }
        ]
      },
      {
        "id": "q6_carry",
        "group": "placement",
        "type": "bool",
        "prompt": "Can you hold a 20 lb dumbbell in one hand for 30 seconds without leaning or hiking that shoulder?"
      },
      {
        "id": "q7_cardio",
        "group": "placement",
        "type": "choice",
        "prompt": "Cardio - pick the hardest one that is true:",
        "choices": [
          {
            "value": "cannot_20",
            "label": "I cannot walk 20 minutes at 3.0 mph comfortably"
          },
          {
            "value": "comfortable",
            "label": "20 minutes at 3.0 mph is comfortable"
          },
          {
            "value": "can_jog_5",
            "label": "That, and I can jog 5 minutes without stopping"
          }
        ]
      },
      {
        "id": "q8_kb",
        "group": "placement",
        "type": "bool",
        "prompt": "Have you swung a kettlebell or done a Turkish get-up before?",
        "help": "This does not change where you start. Everyone starts the swing at hike-and-park with a 20 lb dumbbell and the get-up with no weight. It only decides how much teaching copy the app shows you.",
        "sets_setting": "coaching.kb_experienced"
      },
      {
