{
  "exercises": [
    {
      "id": "turkish_get_up",
      "name": "Turkish get-up",
      "region": "core",
      "pattern": "core",
      "equipment": "floor space, a shoe, dumbbells 8/12/20/35, 53 lb kettlebell",
      "cues": [
        "Eyes on the hand the whole way up; arm vertical and locked, shoulder pulled down and packed",
        "Roll to the elbow, to the hand, bridge the hips, sweep the leg through, lunge up; reverse the exact same path",
        "Never rush and never go to fatigue: this is a skill rehearsal, not a conditioning set",
        "A rep is CLEAN only when all 3 checklist items are ticked"
      ],
      "stop_if": "Sharp shoulder, elbow, wrist or low-back pain, the arm bends or drifts out of vertical, or you cannot control the knee down to the floor",
      "region_weights": {
        "core": 0.4,
        "shoulders": 0.3,
        "glutes": 0.15,
        "thighs": 0.15
      },
      "checklist": {
        "n": 3,
        "cues": [
          "Arm stayed vertical and locked, eyes on the hand",
          "Knee was lowered under control, never dropped or slammed",
          "Every segment smooth, no rushing and no rep to failure"
        ]
      },
      "ladder": [
        {
          "id": "turkish_get_up.naked",
          "ord": 1,
          "name": "Naked get-up",
          "how": "No weight. Raise a closed fist as if it held a bell and walk the full pattern: roll to elbow, to hand, bridge, sweep the leg, lunge to standing, then reverse it. Clear 6 ft of floor beside you.",
          "unit": "reps",
          "sides": "each",
          "A": 1,
          "B": 1,
          "load": {
            "kind": "bw",
            "lb": 0,
            "n": 1,
            "vest_pct": null,
            "cap_lb": null
          },
          "implement_id": "bw",
          "requires": [
            "bw"
          ],
          "checklist_required": true,
          "advance": {
            "rule": "checklist_all_ok",
            "consecutive": 1
          },
          "terminal": false
        },
        {
          "id": "turkish_get_up.shoe",
          "ord": 2,
          "name": "Shoe get-up",
          "how": "Balance a shoe flat on the fist and run the same pattern. The shoe sliding off is a DROP and the rep does not count; log drops honestly.",
          "unit": "reps",
          "sides": "each",
          "A": 1,
          "B": 1,
          "load": {
            "kind": "bw",
            "lb": 0,
