            "rule": "all_sets_reps_gte",
            "value": 15,
            "consecutive": 2
          }
        },
        {
          "id": "db_row.db20",
          "ord": 2,
          "name": "20 lb row",
          "how": "Same setup and tempo, heavier bell. Friday's fourth set may be 2-3 reps lower than the first three; that is fine, it is the advance rule that matters.",
          "unit": "reps",
          "sides": "each",
