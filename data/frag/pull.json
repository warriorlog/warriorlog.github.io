    {
      "id": "db_row",
      "name": "Single-arm row (chair supported)",
      "region": "back",
      "pattern": "pull",
      "equipment": "chair, dumbbells 12/20/35 (single is enough), 53 lb kettlebell",
      "cues": [
        "Hand and same-side knee on the chair, back flat, hips square",
        "Elbow to the hip pocket, 1 s squeeze, full stretch at the bottom",
        "No torso rotation and no shrug: the shoulder blade slides, it does not hike",
        "Tuesday is the light day (3 sets, leave 2-3 reps in the tank); Friday is the heavy day (4 sets, chase the top of the range)"
      ],
      "stop_if": "Sharp pain in the shoulder, elbow or low back, any pinch under the shoulder blade, or a back that rounds and will not flatten between reps",
      "region_weights": {
        "back": 0.7,
        "arms": 0.2,
        "core": 0.1
      },
      "ladder": [
        {
          "id": "db_row.db12",
          "ord": 1,
          "name": "12 lb row",
          "how": "Hand and knee on the chair, spine long. 2 s down, 1 s squeeze. Tuesday 3 sets at the low end; Friday 4 sets toward the high end.",
          "unit": "reps",
          "sides": "each",
          "A": 10,
          "B": 15,
          "load": {
            "kind": "db",
            "lb": 12,
            "n": 1,
            "vest_pct": null,
            "cap_lb": null
          },
          "implement_id": "db12",
          "requires": [
            "chair",
